# Optional: used if no key is saved in Library → Connections (a saved key takes precedence)
ANTHROPIC_API_KEY=sk-ant-...

# Required: signs session cookies and encrypts saved API keys and MCP credentials. Without it nobody can sign in.
# Generate with: openssl rand -base64 32. Changing it signs everyone out and makes saved keys unreadable.
# On first visit you paste it to create the admin account (or: npx tsx scripts/user.mts add you@example.com --admin)
AUTH_SECRET=

# Optional: embeddings for Knowledge search (a key saved in Library → Connections takes precedence). Without it, search is keyword-only.
# OPENAI_API_KEY=sk-...

# Optional: refuse new chat turns once today's runs have cost this many dollars.
# DAILY_BUDGET_USD=5
# Optional: the same cap for each member.
# USER_DAILY_BUDGET_USD=1

# Optional: public demo. Adds "Try the demo" to sign-in: read-only guests, each with private chats.
# Stays off unless DAILY_BUDGET_USD and USER_DAILY_BUDGET_USD are both set. Guest signups: 3 per IP per hour, this many a day.
# DEMO=1
# DEMO_GUESTS_PER_DAY=200

# Hosted database (Vercel Marketplace: Turso). Leave unset locally: data/app.db is used.
# TURSO_DATABASE_URL=libsql://...
# TURSO_AUTH_TOKEN=
