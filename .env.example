# Optional: used if no key is saved in Settings (Settings takes precedence)
ANTHROPIC_API_KEY=sk-ant-...

# Required: password for the single admin account. Without it nobody can sign in.
ADMIN_PASSWORD=change-me
# Optional: key used to sign session cookies (defaults to ADMIN_PASSWORD)
# AUTH_SECRET=
# Also encrypts the saved API key and MCP credentials. Set it so changing ADMIN_PASSWORD does not lock them.

# Optional: embeddings for Knowledge search (Settings takes precedence). Without it, search is keyword-only.
# OPENAI_API_KEY=sk-...
